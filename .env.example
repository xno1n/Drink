# Copy to .env.local (never commit .env.local).
# Find both values in Supabase Dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the public "anon" key ONLY. Never put the service_role key in this app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: comma-separated OAuth providers to show on login/signup
# (they must also be enabled in Supabase -> Authentication -> Providers). Example: google,github
NEXT_PUBLIC_OAUTH_PROVIDERS=
